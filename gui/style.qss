/* style.qss */
QWidget {
    font-family: Arial;
    font-size: 14px;
    background-color: #2c3e50;
    color: #ecf0f1;
}

QPushButton {
    background-color: #3498db;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #2980b9;
}

#sortFilesButton {
    background-color: #1abc9c;
    color: white;
    border: 2px solid #16a085;
    border-radius: 10px;
    padding: 8px 16px;
}

#sortFilesButton:hover {
    background-color: #16a085;
}